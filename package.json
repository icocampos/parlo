{
  "name": "parlo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @parlo/api",
    "dev:mobile": "npm run start --workspace @parlo/mobile",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @parlo/api",
    "db:migrate": "npm run db:migrate --workspace @parlo/api"
  },
  "engines": {
    "node": ">=22"
  }
}
