{
  "expo": {
    "name": "Parlo",
    "slug": "parlo",
    "scheme": "parlo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Permita que o Parlo use o microfone para praticar conversação.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parlo.app"
    },
    "android": {
      "package": "com.parlo.app"
    }
  }
}
